# ---------------------------------------------------------------- database --
# Neon: create a project, then Dashboard → Connection string → "pooled".
# Looks like: postgresql://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The same string with "-pooler" removed from the hostname (Neon Console:
# turn the "Connection pooling" toggle OFF). Used only for migrations and
# drizzle studio, which want a direct session. Optional but recommended.
DATABASE_URL_UNPOOLED=

# ------------------------------------------------------------------- auth --
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# Application type: Web application
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anyone signing in with a verified @this-domain address is admitted as staff.
# Leave blank to admit only addresses already in the `people` table.
ALLOWED_EMAIL_DOMAIN=

# ----------------------------------------------------------------- ingest --
# Shared secret the scanners send as the x-ingest-key header.
# Generate with: openssl rand -hex 24
INGEST_KEY=
